# Template only. Do not put real values in this file.
# Spring does not load .env files automatically. Export these variables in
# your shell, or set them in the hosting dashboard (Render).
# Secret: long random string, at least 32 bytes.
JWT_SECRET=
# Minutes until a login token expires.
JWT_EXPIRY_MINUTES=
# Example format: jdbc:postgresql://<host>:<port>/<database>
DATABASE_URL=
# Database user.
DB_USERNAME=
# Secret: database password.
DB_PASSWORD=
# Redis host.
REDIS_HOST=
# Redis port.
REDIS_PORT=
# Allowed frontend origin, for example https://your-frontend.example.com
CORS_ORIGIN=
# Cache lifetime in minutes.
CACHE_TTL_MINUTES=
# Login and registration attempts allowed per window.
AUTH_RATE_LIMIT_MAX_REQUESTS=
# Length of the rate-limit window in minutes.
AUTH_RATE_LIMIT_WINDOW_MINUTES=
# sandbox or test-mode Razorpay; never live keys in this template.
PAYMENT_MODE=
# Razorpay test key ID.
RAZORPAY_KEY_ID=
# Secret: Razorpay test key secret.
RAZORPAY_KEY_SECRET=
# Secret: Razorpay webhook signing secret.
RAZORPAY_WEBHOOK_SECRET=
# AWS region, for example ap-south-1.
AWS_REGION=
# S3 bucket name for uploaded media.
S3_BUCKET=
