.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local databases and uploaded user content.
*.db
*.sqlite
*.sqlite3
uploads/
repomix-output.txt
**/uploads/

# Local platform configuration and logs.
.vercel/
frontend/.vercel/
*.log
.DS_Store
Thumbs.db

# Verification, audit spreadsheets, and test artifacts
*.xlsx
.github/modernize/
scripts/dev/*.log
tmp/
*.tmp
.agents/

